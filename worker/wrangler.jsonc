// Cloudflare Worker configuration for FlyAlert.
// One Worker serves everything on one domain:
//   • the website (the built React app in ../dist, "static assets"),
//   • the API under /api/*,
//   • the scheduled price checks (cron).
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyalert",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The website. Build it first with `npm run build` in the project root.
  "assets": {
    "directory": "../dist",
    // Unknown paths (e.g. /dashboard) return index.html so React Router can handle them.
    "not_found_handling": "single-page-application",
    // /api/* always goes to our Worker code, never to the website files.
    // /__scheduled is wrangler dev's "run the cron now" test URL (404 in production).
    "run_worker_first": ["/api/*", "/__scheduled"]
  },

  // Price checks: runs every hour at minute 0 and checks the alerts whose
  // last check is the oldest (each alert is checked roughly every 6 hours).
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // AI assistant: Workers AI (free plan = 10,000 neurons per day, no card needed).
  // Note: even in `wrangler dev`, AI requests run on Cloudflare and use this quota.
  "ai": { "binding": "AI" },

  // Max 8 assistant messages per minute per visitor, so nobody can burn the free quota.
  "ratelimits": [
    {
      "name": "ASSISTANT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      // "Send a test notification": max 3 per minute per visitor.
      "name": "PUSH_TEST_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  // Public, non-secret settings.
  // Secrets (TRAVELPAYOUTS_TOKEN, SUPABASE_SECRET_KEY, VAPID_PRIVATE_KEY) live in .dev.vars locally
  // and in `wrangler secret put` in production — never here.
  "vars": {
    // Only needed for local development (Vite on :5173). In production the
    // website and API share one domain, so no cross-origin access is required.
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "SUPABASE_URL": "https://oyoulbqmnsbhyrbtgeqm.supabase.co",
    // Hours between two checks of the same alert (can be overridden in .dev.vars for testing).
    "PRICE_CHECK_INTERVAL_HOURS": "6",
    // Travelpayouts partner ID ("marker", digits only). It is public — it appears in every
    // booking link — and earns FlyAlert a commission on bookings. Empty = no commission.
    "TRAVELPAYOUTS_MARKER": "",
    // Web Push (phone/browser notifications). The PUBLIC key is safe to share —
    // browsers need it. The matching private key is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BKsB9FNG3k0M0TLg_dXBpIdboNDH_VmkIrK5pH_NUZk-hchASAP2XzsSqLKi1hik833Gy2a-hWfWAYr7lUQeGDw",
    // Contact that push services (Google, Apple, Mozilla) can use if something goes wrong.
    "VAPID_SUBJECT": "https://flyalert.slaydirella.workers.dev"
  }
}
