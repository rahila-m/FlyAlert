{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"],
  // Unit tests run with Vitest from the project root (npm test).
  "exclude": ["src/**/*.test.ts"]
}
