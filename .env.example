# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is ignored by Git (see .gitignore: *.local) and must never be committed.
#
# Only variables starting with VITE_ are exposed to the browser.
# These two values are PUBLIC by design: data is protected by Row Level Security.
# NEVER put the Supabase `service_role` / secret key or the database password here.

# Supabase dashboard → Project Settings → API (or the "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
